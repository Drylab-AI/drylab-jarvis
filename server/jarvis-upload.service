# systemd user unit for the Jarvis upload server.
#
# Install (no sudo):
#   mkdir -p ~/.config/systemd/user
#   cp jarvis-upload.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now jarvis-upload.service
#   loginctl enable-linger $USER   # so it runs even when you are not logged in
#
# Logs:  journalctl --user -u jarvis-upload -f

[Unit]
Description=Jarvis voice-clip upload server
After=network-online.target
Wants=network-online.target

[Service]
# Adjust WorkingDirectory if you move the repo.
WorkingDirectory=%h/Work/Drylab/jarvis/server
ExecStart=%h/.local/bin/uv run uvicorn app:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=3
# Uncomment to turn on the shared-secret token:
# Environment=JARVIS_TOKEN=change-me

[Install]
WantedBy=default.target
