# Recordings and uploaded clips (runtime data, can be large)
recordings/
*.m4a
*.m4a.json

# Firmware images and factory zips (very large, device-specific; keep locally)
firmware/
*.img
*.zip

# Python / uv
server/.venv/
__pycache__/
*.pyc
.uv/

# Android build outputs
android-app/.gradle/
android-app/.kotlin/
android-app/build/
android-app/app/build/
android-app/local.properties
*.apk
*.aab
*.keystore

# openWakeWord JVM verification harness build outputs
tools/oww/kt-check/.gradle/
tools/oww/kt-check/build/
tools/oww/kt-check/.kotlin/

# Magisk module build artifacts
magisk-module/build/
magisk-module/*.zip

# Test run logs (proof lives under tests/, but keep heavy raw logs out)
tests/logs/toolchain/
tests/logs/server-test.log
tests/logs/server-run.log

# Editor / OS
.DS_Store
*.swp
.idea/
