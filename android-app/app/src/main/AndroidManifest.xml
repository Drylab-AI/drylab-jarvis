<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the wake word surface the assistant from the background. A
         background service cannot call startActivity on Android 10+ (the
         launch is BAL_BLOCKed), and a full-screen intent only takes over the
         screen while it is locked. Holding the overlay permission ("Display
         over other apps") restores the background-activity-launch exemption so
         saying "hey jarvis" opens the assistant on an unlocked screen too. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisVoiceRec">

        <!-- Main settings / status screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible trampoline the root daemon pokes with `am start`.
             Needed because since Android 14 a background app cannot start a
             microphone foreground service; bringing this to the foreground for
             a moment lets RecordService start legally. -->
        <activity
            android:name=".ToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="com.jarvis.voicerec.TOGGLE" />
                <action android:name="com.jarvis.voicerec.START" />
                <action android:name="com.jarvis.voicerec.STOP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Invisible trampoline for the front-camera stream. Must be able to
             show over the lock screen so camera/mic use is allowed while
             locked (see CamToggleActivity). -->
        <activity
            android:name=".CamToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="com.jarvis.voicerec.CAM_TOGGLE" />
                <action android:name="com.jarvis.voicerec.CAM_START" />
                <action android:name="com.jarvis.voicerec.CAM_STOP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Voice AI assistant: full-screen UI (works over the lock screen)
             driven by the root daemon / wake word, backed by a mic+camera
             foreground service that bridges to the PC over a WebSocket. -->
        <activity
            android:name=".AssistantActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.JarvisVoiceRec">
            <intent-filter>
                <action android:name="com.jarvis.voicerec.ASSISTANT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AssistantService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Always-on "Jarvis" wake-word listener. -->
        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
